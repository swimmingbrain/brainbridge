{
  "name": "brainbridge",
  "version": "0.1.0",
  "description": "MCP server that lets Claude Code and other agents drive brainotes and texbrain, the browser note and LaTeX apps, live in your tabs.",
  "author": "Braian Plaku",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brainbridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "handwriting",
    "latex",
    "brainotes",
    "texbrain"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "katex": "^0.18.7",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
